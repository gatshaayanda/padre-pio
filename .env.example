# Set only for the dedicated Padre Pio environment.
# Keep blank until the clinic's canonical domain is confirmed.
NEXT_PUBLIC_BASE_URL=

# Dedicated Firebase web app configuration (never use another project's values).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-side Firebase Admin credential for the private patient-history API and one-word reception login.
# Never expose this value with a NEXT_PUBLIC_ prefix.
FIREBASE_ADMIN_KEY=

# One-word reception login secret; set a strong, unique secret in the server environment.
ADMIN_PASSWORD=
# UID of an already-provisioned admins/{uid} document with role owner or staff.
# The login endpoint will NOT create or promote an admin role.
PADRE_PIO_ADMIN_UID=
