rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff'];
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    function validAppointmentCreate() {
      return request.resource.data.keys().hasOnly([
          'patientUid', 'patientName', 'phone', 'preferredDate', 'preferredTime',
          'category', 'patientNote', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'patientUid', 'patientName', 'phone', 'preferredDate', 'preferredTime',
          'category', 'patientNote', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.patientUid == request.auth.uid
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0
        && request.resource.data.patientName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredTime in ['MORNING', 'AFTERNOON', 'FLEXIBLE']
        && request.resource.data.category in ['GENERAL_APPOINTMENT', 'FOLLOW_UP', 'NOT_SURE']
        && request.resource.data.patientNote is string
        && request.resource.data.patientNote.size() <= 300
        && request.resource.data.status == 'NEW'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validStatusTransition() {
      let current = resource.data.status;
      let next = request.resource.data.status;
      return current == next
        || (current == 'NEW' && next in ['REVIEWING', 'CANCELLED'])
        || (current == 'REVIEWING' && next in ['APPROVED', 'RESCHEDULE_REQUESTED', 'CANCELLED'])
        || (current == 'APPROVED' && next in ['CONFIRMED', 'RESCHEDULE_REQUESTED', 'CANCELLED'])
        || (current == 'CONFIRMED' && next in ['COMPLETED', 'RESCHEDULE_REQUESTED', 'CANCELLED'])
        || (current == 'RESCHEDULE_REQUESTED' && next in ['REVIEWING', 'APPROVED', 'CONFIRMED', 'CANCELLED'])
        || (current in ['COMPLETED', 'CANCELLED'] && next == current);
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /appointments/{appointmentId} {
      // Patients can submit requests but cannot read the private reception record,
      // which may contain an internal note. The form shows a reference after write success.
      allow create: if signedIn() && validAppointmentCreate();
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.patientUid == resource.data.patientUid
        && request.resource.data.patientName == resource.data.patientName
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.preferredDate == resource.data.preferredDate
        && request.resource.data.preferredTime == resource.data.preferredTime
        && request.resource.data.category == resource.data.category
        && request.resource.data.patientNote == resource.data.patientNote
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'patientUid', 'patientName', 'phone', 'preferredDate', 'preferredTime',
          'category', 'patientNote', 'status', 'createdAt', 'updatedAt', 'adminNote'
        ])
        && request.resource.data.status in [
          'NEW', 'REVIEWING', 'APPROVED', 'CONFIRMED',
          'RESCHEDULE_REQUESTED', 'COMPLETED', 'CANCELLED'
        ]
        && validStatusTransition()
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(['adminNote']) || (
          request.resource.data.adminNote is string && request.resource.data.adminNote.size() <= 500
        ));
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
